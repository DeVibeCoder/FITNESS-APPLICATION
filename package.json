{
  "name": "fitness",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "verify": "tsx --tsconfig tsconfig.app.json scripts/verify-data.ts && tsx --tsconfig tsconfig.app.json scripts/verify-upgrade.ts",
    "icons": "node scripts/generate-icons.mjs",
    "audit": "node scripts/audit.mjs",
    "deploy": "npm run build && wrangler pages deploy dist --project-name fitness-application --branch main",
    "db:migrations": "wrangler d1 migrations list circuit-dev --env preview --remote",
    "db:migrate:dev": "wrangler d1 migrations apply circuit-dev --env preview --remote",
    "db:reference": "tsx --tsconfig tsconfig.app.json scripts/build-reference-migration.ts",
    "db:check:dev": "tsx --tsconfig tsconfig.app.json scripts/check-dev-db.ts",
    "db:check:guard": "tsx --tsconfig tsconfig.app.json scripts/check-seed-guard.ts",
    "db:check:auth": "tsx --tsconfig tsconfig.app.json scripts/check-auth.ts",
    "db:check:ai": "tsx --tsconfig tsconfig.app.json scripts/check-ai-endpoints.ts",
    "db:check:authcfg": "tsx --tsconfig tsconfig.app.json scripts/check-auth-config.ts",
    "db:check:e2e": "tsx --tsconfig tsconfig.app.json scripts/check-auth-e2e.ts",
    "db:check:link": "tsx --tsconfig tsconfig.app.json scripts/check-identity-link.ts"
  },
  "dependencies": {
    "better-auth": "^1.7.2",
    "dexie": "^4.4.5",
    "dexie-react-hooks": "^4.4.0",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "fake-indexeddb": "^6.2.5",
    "oxlint": "^1.75.0",
    "tsx": "^4.23.12",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "wrangler": "^4.124.0"
  }
}
