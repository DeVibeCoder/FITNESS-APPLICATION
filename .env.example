# Server-side only. These are read by the /api/food-scan and /api/workout-scan
# endpoints in the Node process — never by the browser. Vite only exposes
# variables prefixed with VITE_ to the client bundle, so nothing here can reach
# a user's device.
#
# Copy to `.env` and fill in. `.env` is git-ignored.

# Google Gemini — food identification from a photo, and reading the workout
# summary off a screenshot. Required for both. Get one at
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Defaults to gemini-3.6-flash, a current cost-efficient vision model.
# GEMINI_MODEL=gemini-3.6-flash

# USDA FoodData Central — nutrition values for identified foods. Optional but
# strongly recommended: without it, foods are detected but arrive with zeroed
# nutrition for you to fill in.
# Free key at https://fdc.nal.usda.gov/api-key-signup
FDC_API_KEY=

# Development only. Set to 1 to bypass the real vision provider with an obvious
# placeholder while working on the review UI. Ignored when NODE_ENV=production,
# and never used as a fallback when the real provider fails.
# FOOD_SCAN_MOCK=0

# The same, for the workout screenshot reader. Separate flags on purpose: they
# are different flows and you will usually want only one of them stubbed.
# WORKOUT_SCAN_MOCK=0
