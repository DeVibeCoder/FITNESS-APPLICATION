# Local development values for `wrangler pages dev`.
#
# Copy to `.dev.vars` and fill in. `.dev.vars` is gitignored and must stay
# that way — nothing in this file is a real secret, and nothing real belongs
# in source control.
#
# Deployed environments get these through `wrangler pages secret put <NAME>`
# or the Cloudflare dashboard, never through this file.

# Which database this process believes it is pointed at. Anything other than
# "development" — including leaving it unset — refuses fixture seeding.
ENVIRONMENT=development

# Existing AI and nutrition integration. Server-side only; these must never be
# prefixed VITE_ or they would be bundled into the browser.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
FDC_API_KEY=

# Development-only stand-ins for the vision providers. Both are additionally
# refused when NODE_ENV is production, in server/*/handler.ts.
WORKOUT_SCAN_MOCK=0
FOOD_SCAN_MOCK=0

# --- Authentication -------------------------------------------------------
#
# Required for /api/auth to work at all. Without AUTH_SECRET the route answers
# 503 rather than pretending: a generated secret would sign sessions that stop
# verifying the moment the isolate is replaced.
#
# Generate one with:  openssl rand -base64 32
AUTH_SECRET=

# Google sign-in. Optional — the provider is simply absent when these are
# unset, and email/password still works.
#
# Create an OAuth 2.0 Client ID (type: Web application) in Google Cloud
# Console, then register these exact redirect URIs:
#
#   local dev    http://localhost:8788/api/auth/callback/google
#   preview      https://<deployment>.fitness-application-7vt.pages.dev/api/auth/callback/google
#   production   https://fitness-application-7vt.pages.dev/api/auth/callback/google
#
# Authorised JavaScript origins are the same URLs without the path.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Overrides the origin Better Auth builds callback URLs from. Only needed when
# the request origin is not the public one (a tunnel, a proxy).
# BASE_URL=http://localhost:8788
